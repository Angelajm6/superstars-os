# Superstars Contracting — Project Console
# API key configuration. Copy this file to ".env" (without .template) and fill in your real keys.
# .env is read by the Python workflow scripts at runtime. Never commit .env to a repo.

# =====================================================================
# SENDGRID — Email distribution
# =====================================================================
# Get from: https://app.sendgrid.com/settings/api_keys
# Create with name "superstars-pm-dev", permissions: Mail Send only.
# Format: SG.xxxxxxxxxxxxxx.xxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_API_KEY=

# Verified sender email (must be verified in SendGrid Sender Authentication)
# For dev: a single verified email like amit@superstarscontracting.com
# For prod: a domain-authenticated address like reports@superstarscontracting.com
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=Superstars Contracting

# =====================================================================
# TWILIO — SMS alerts (foreman summaries, urgent RFI alerts)
# =====================================================================
# Get from: https://console.twilio.com
# Create with name "superstars-pm-dev"
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# =====================================================================
# ANTHROPIC CLAUDE API — AI note-taker for meeting minutes
# =====================================================================
# Stored in 1Password Business → vault "Dashboard Secrets" → item "Anthropic API" → field "credential".
# Resolved at runtime by:  op run --env-file=".env.template" -- python <script>
# Never paste the raw sk-ant-api03-... key here or anywhere else on disk.
ANTHROPIC_API_KEY="op://Dashboard Secrets/Anthropic API/credential"

# =====================================================================
# FIELD ENCRYPTION KEY — encrypts OAuth tokens and inbox content at rest (secret_box.py)
# =====================================================================
# Stored in 1Password Business → vault "Dashboard Secrets" → item "Field Encryption Key"
# → field "credential". Generate once with:  python secret_box.py --generate-key
# Resolved at runtime by:  op run --env-file=".env.template" -- python <script>
# Rotation: set a comma-separated list, NEW key first; old keys stay listed until every
# stored value has been re-wrapped (secret_box.rewrap). Losing this key makes encrypted
# data unrecoverable — keep a 1Password backup. Never put the raw key on disk or in chat.
SSC_FIELD_ENCRYPTION_KEY="op://Dashboard Secrets/Field Encryption Key/credential"

# =====================================================================
# OPENAI — Whisper for audio transcription (optional, for AI note-taker)
# =====================================================================
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# =====================================================================
# OPEN-METEO WEATHER API
# =====================================================================
# No key needed — free public API. Already wired in generate_dcr.py.

# =====================================================================
# GOOGLE OIDC SSO (#261) — "Sign in with Google" for internal staff
# =====================================================================
# Register an OAuth 2.0 "Web application" client at
#   https://console.cloud.google.com/apis/credentials
# The Authorized redirect URI there MUST exactly equal GOOGLE_OAUTH_REDIRECT_URI
# below (Tailscale prod: https://ssc-bkbase.tail55067c.ts.net/auth/google/callback).
#
# FEATURE FLAG: with these UNSET the feature is OFF — the button is hidden, the
# /auth/google/* routes return 404, and email/password works exactly as today. Set
# all of CLIENT_ID + CLIENT_SECRET + REDIRECT_URI to enable it.
#
# The client ID is NOT a secret (it is sent to the browser). The client SECRET IS —
# keep it in 1Password (per the secrets rule); never plaintext on disk, never logged,
# never committed. Resolved at runtime via op-run, like ANTHROPIC_API_KEY above.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET="op://Dashboard Secrets/Google OAuth/client_secret"
GOOGLE_OAUTH_REDIRECT_URI=
# Optional — defaults to superstarscontracting.com. Only verified identities in this
# Google Workspace domain may sign in via Google (enforced on the ID-token claims).
GOOGLE_OAUTH_ALLOWED_DOMAIN=superstarscontracting.com

# =====================================================================
# Settings
# =====================================================================
# Set to "true" to actually send emails/SMS, "false" to draft only (safer for testing)
LIVE_MODE=false

# In dev mode, all emails route to this address regardless of the configured recipient list.
# Set to your own email so you can test the full pipeline without bothering real stakeholders.
DEV_EMAIL_OVERRIDE=
