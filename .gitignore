# =====================================================================
# .gitignore — Superstars Contracting dashboard
# Excludes secrets, data, and noise from the git repository.
# Anything matched here NEVER gets pushed to GitHub.
# =====================================================================

# ===== SECRETS — NEVER COMMIT =====
.env
.env.*
!.env.example
!.env.template
*.key
*.pem
secrets/
credentials.json
service-account*.json
# Critical: api-keys.txt is the actual SendGrid (and possibly other) key file
# loaded by send_rfi_emails.py. NEVER commit.
api-keys.txt
api_keys.txt
api-keys.*.txt

# ===== DATABASE — starts fresh on workstation =====
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
superstars.db*

# ===== UPLOADED USER FILES — never travel via git =====
uploads/
worker_intake_inbox/
worker_files/
field_photos/

# ===== GENERATED OUTPUT (PDFs, reports, etc) =====
# These are generated from the templates — no need to ship them.
# Comment out specific ones if you DO want to ship sample renders.
DCR-*-internal.pdf
DCR-*-client.pdf
WPS-*-internal.pdf
WPS-*-client.pdf
LA-*.pdf
RFI-*.pdf
Closure-*.pdf
M-*.pdf
TBT-*.pdf
DP-*.pdf
cof_card_final*.pdf
rfi_workflow_run/
meeting_workflow_run/

# Keep the HTML templates — those ARE part of the source.

# ===== PYTHON =====
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environment — reinstall on workstation from requirements.txt
venv/
env/
ENV/
.venv/

# ===== IDE / EDITOR =====
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# ===== OS =====
$RECYCLE.BIN/
*.lnk
ehthumbs.db

# ===== LOGS =====
*.log
server.log
logs/

# ===== CLAUDE / AI WORK ARTIFACTS =====
# Ignore everything under .claude/ EXCEPT version-controlled sub-agent
# discovery stubs (#198): the thin pointer stubs that make Task-tool
# sub-agents auto-discoverable (construction-specialist, and future roster
# agents) must travel with the repo so discovery works on any clone. Local
# settings (launch.json, settings.local.json) stay ignored. The contents-
# glob + re-include idiom is required because git cannot re-include a file
# whose parent directory is wholesale-excluded.
.claude/*
!.claude/agents/
!.claude/commands/
.cursor/

# ===== TEMP =====
tmp/
temp/
*.tmp
*.bak
*.backup
*.orig

# ===== NODE / JAVASCRIPT DEPENDENCIES =====
# Massive folders, never committed. Reinstall via npm if needed.
node_modules/
package-lock.json
yarn.lock
npm-debug.log*

# ===== EXCEL / OFFICE FILES WITH POTENTIAL REAL DATA =====
# These workbooks may contain real worker / project data.
# Excluded by default — uncomment with `!` to whitelist specific templates.
*.xlsx
*.xlsm
*.xls
*.docx
*.pptx
# Specific templates to ship (uncomment if needed):
# !template-*.xlsx

# ===== DATA ROOM — project documents =====
# data_room/ holds DOB filings, drawings, permits, specs.
# Gitignore everything inside EXCEPT folder structure markers.
data_room/**/*
!data_room/**/.placeholder
!data_room/**/README.md
!data_room/**/INSTRUCTIONS.md

# ===== INTAKE — scratch space for photos pending worker intake =====
# Folder structure tracked via .gitkeep; all contents (raw photos, scans,
# anything dropped here for OpenCV cropping or manual review) excluded.
intake/*
!intake/.gitkeep

# ===== WORKER RECORDS — PII-bearing per-worker folders =====
# Holds cropped cert photos, ID images, and headshots once real workers land.
# Even on a private repo, real worker PII never gets git-tracked
# (CLAUDE.md rule #2). Structure preserved via .gitkeep, all contents excluded.
worker_records/*
!worker_records/.gitkeep

# ===== GENERATED HTML RENDERS WITH PROJECT-SPECIFIC DATA =====
# These are output files (rendered with sample data), not source templates.
# The templates themselves (no project_code / dates in filename) ARE source — keep.
# Match any project_code prefix (SC-, FR-BX-, FR-MN-, IRA-, PG-, INT-, etc.)
DCR-*-internal.html
DCR-*-internal.json
DCR-*-client.html
DCR-*-client.json
WPS-*-internal.html
WPS-*-internal.json
WPS-*-client.html
WPS-*-client.json
LA-*.html
LA-*.json
RFI-001.html
RFI-002.html
RFI-003.html
RFI-001.json
RFI-002.json
RFI-003.json
site_closures/Closure-*
meetings/M-*
toolbox_talks/TBT-*
drop_plans/DP-*

# ===== MISC NOISE =====
MIGRATION_REPORT.txt
*.placeholder

# ===== CSV LEDGERS — DECIDE PER FILE =====
# Subscription ledger: business-sensitive (owner emails, MFA methods, admin links).
# Lives in Google Drive since the repo went public (2026-10-21); never commit it.
subscriptions_ledger.csv

# #259 dev-only local Postgres (binaries + data) � never commit
.pgdev/
.dev_db_url

# ===== TEST FIXTURES (#293) - large binaries stay out of git =====
# The drawing-set fixture (~12.8 MB PDF) lives here on the workstation;
# provenance + re-copy instructions in tests/fixtures/README.md (committed).
tests/fixtures/*.pdf
